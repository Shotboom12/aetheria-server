INSERT INTO `spell_script_names` (`spell_id`, `ScriptName`) VALUES (111004, 'spell_race_ethereal_two_forms');
-- Ethereal Alliance: race 77; all starts retain the faction donor location.
DELETE FROM `playercreateinfo` WHERE `race` = 77;
INSERT INTO `playercreateinfo` (`race`, `class`, `map`, `zone`, `position_x`, `position_y`, `position_z`, `orientation`)
SELECT 77, `classes`.`class`, `p`.`map`, `p`.`zone`, `p`.`position_x`, `p`.`position_y`, `p`.`position_z`, `p`.`orientation`
FROM `playercreateinfo` AS `p` CROSS JOIN (
    SELECT 1 AS `class`
    UNION ALL SELECT 2 AS `class`
    UNION ALL SELECT 3 AS `class`
    UNION ALL SELECT 4 AS `class`
    UNION ALL SELECT 5 AS `class`
    UNION ALL SELECT 7 AS `class`
    UNION ALL SELECT 8 AS `class`
    UNION ALL SELECT 9 AS `class`
    UNION ALL SELECT 11 AS `class`
) AS `classes`
WHERE `p`.`race` = 1 AND `p`.`class` = 1;
DELETE FROM `player_race_stats` WHERE `Race` = 77;
INSERT INTO `player_race_stats` (`Race`, `Strength`, `Agility`, `Stamina`, `Intellect`, `Spirit`)
SELECT 77, `Strength`, `Agility`, `Stamina`, `Intellect`, `Spirit` FROM `player_race_stats` WHERE `Race` = 1;
DELETE FROM `playercreateinfo_item` WHERE `race` = 77;
INSERT INTO `playercreateinfo_item` (`race`, `class`, `itemid`, `amount`, `Note`)
SELECT 77, `p`.`class`, `p`.`itemid`, `p`.`amount`, `p`.`Note` FROM `playercreateinfo_item` AS `p`
WHERE (`p`.`race` = 1 AND `p`.`class` = 1)
    OR (`p`.`race` = 1 AND `p`.`class` = 2)
    OR (`p`.`race` = 1 AND `p`.`class` = 3)
    OR (`p`.`race` = 1 AND `p`.`class` = 4)
    OR (`p`.`race` = 1 AND `p`.`class` = 5)
    OR (`p`.`race` = 11 AND `p`.`class` = 7)
    OR (`p`.`race` = 1 AND `p`.`class` = 8)
    OR (`p`.`race` = 1 AND `p`.`class` = 9)
    OR (`p`.`race` = 4 AND `p`.`class` = 11);
DELETE FROM `playercreateinfo_action` WHERE `race` = 77;
INSERT INTO `playercreateinfo_action` (`race`, `class`, `button`, `action`, `type`)
SELECT 77, `p`.`class`, `p`.`button`, `p`.`action`, `p`.`type` FROM `playercreateinfo_action` AS `p`
WHERE (`p`.`race` = 1 AND `p`.`class` = 1)
    OR (`p`.`race` = 1 AND `p`.`class` = 2)
    OR (`p`.`race` = 1 AND `p`.`class` = 3)
    OR (`p`.`race` = 1 AND `p`.`class` = 4)
    OR (`p`.`race` = 1 AND `p`.`class` = 5)
    OR (`p`.`race` = 11 AND `p`.`class` = 7)
    OR (`p`.`race` = 1 AND `p`.`class` = 8)
    OR (`p`.`race` = 1 AND `p`.`class` = 9)
    OR (`p`.`race` = 4 AND `p`.`class` = 11);
-- Ethereal Horde: race 78; all starts retain the faction donor location.
DELETE FROM `playercreateinfo` WHERE `race` = 78;
INSERT INTO `playercreateinfo` (`race`, `class`, `map`, `zone`, `position_x`, `position_y`, `position_z`, `orientation`)
SELECT 78, `classes`.`class`, `p`.`map`, `p`.`zone`, `p`.`position_x`, `p`.`position_y`, `p`.`position_z`, `p`.`orientation`
FROM `playercreateinfo` AS `p` CROSS JOIN (
    SELECT 1 AS `class`
    UNION ALL SELECT 2 AS `class`
    UNION ALL SELECT 3 AS `class`
    UNION ALL SELECT 4 AS `class`
    UNION ALL SELECT 5 AS `class`
    UNION ALL SELECT 7 AS `class`
    UNION ALL SELECT 8 AS `class`
    UNION ALL SELECT 9 AS `class`
    UNION ALL SELECT 11 AS `class`
) AS `classes`
WHERE `p`.`race` = 2 AND `p`.`class` = 1;
DELETE FROM `player_race_stats` WHERE `Race` = 78;
INSERT INTO `player_race_stats` (`Race`, `Strength`, `Agility`, `Stamina`, `Intellect`, `Spirit`)
SELECT 78, `Strength`, `Agility`, `Stamina`, `Intellect`, `Spirit` FROM `player_race_stats` WHERE `Race` = 2;
DELETE FROM `playercreateinfo_item` WHERE `race` = 78;
INSERT INTO `playercreateinfo_item` (`race`, `class`, `itemid`, `amount`, `Note`)
SELECT 78, `p`.`class`, `p`.`itemid`, `p`.`amount`, `p`.`Note` FROM `playercreateinfo_item` AS `p`
WHERE (`p`.`race` = 2 AND `p`.`class` = 1)
    OR (`p`.`race` = 10 AND `p`.`class` = 2)
    OR (`p`.`race` = 2 AND `p`.`class` = 3)
    OR (`p`.`race` = 2 AND `p`.`class` = 4)
    OR (`p`.`race` = 5 AND `p`.`class` = 5)
    OR (`p`.`race` = 2 AND `p`.`class` = 7)
    OR (`p`.`race` = 5 AND `p`.`class` = 8)
    OR (`p`.`race` = 2 AND `p`.`class` = 9)
    OR (`p`.`race` = 6 AND `p`.`class` = 11);
DELETE FROM `playercreateinfo_action` WHERE `race` = 78;
INSERT INTO `playercreateinfo_action` (`race`, `class`, `button`, `action`, `type`)
SELECT 78, `p`.`class`, `p`.`button`, `p`.`action`, `p`.`type` FROM `playercreateinfo_action` AS `p`
WHERE (`p`.`race` = 2 AND `p`.`class` = 1)
    OR (`p`.`race` = 10 AND `p`.`class` = 2)
    OR (`p`.`race` = 2 AND `p`.`class` = 3)
    OR (`p`.`race` = 2 AND `p`.`class` = 4)
    OR (`p`.`race` = 5 AND `p`.`class` = 5)
    OR (`p`.`race` = 2 AND `p`.`class` = 7)
    OR (`p`.`race` = 5 AND `p`.`class` = 8)
    OR (`p`.`race` = 2 AND `p`.`class` = 9)
    OR (`p`.`race` = 6 AND `p`.`class` = 11);
