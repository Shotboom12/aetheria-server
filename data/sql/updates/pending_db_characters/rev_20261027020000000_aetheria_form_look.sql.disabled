-- Kalibros/STRHercules Two Forms persistence, adapted for Aetheria.
-- Disabled until the matching client/server/asset installation is prepared.
CREATE TABLE IF NOT EXISTS `character_form_look` (
  `guid` int unsigned NOT NULL,
  `data` varbinary(132) NOT NULL,
  PRIMARY KEY (`guid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
