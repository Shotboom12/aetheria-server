if(TARGET modules)
  # Acore recursively auto-collects module sources before including this file.
  # Drop that module's auto-collected C/C++ files, then add only the reviewed set above.
  get_target_property(_classless_wildcard_all_sources modules SOURCES)
  set(_classless_wildcard_filtered_sources)
  foreach(_classless_wildcard_source IN LISTS _classless_wildcard_all_sources)
    get_filename_component(
      _classless_wildcard_source_abs
      "${_classless_wildcard_source}"
      ABSOLUTE)
    file(RELATIVE_PATH _classless_wildcard_source_rel "${CMAKE_SOURCE_DIR}" "${_classless_wildcard_source_abs}")
    if(_classless_wildcard_source_rel MATCHES "^modules/mod-classless-wildcard/src/.*[.](c|cc|cpp)$")
      continue()
    endif()
    list(APPEND _classless_wildcard_filtered_sources "${_classless_wildcard_source}")
  endforeach()
  set_property(TARGET modules PROPERTY SOURCES "${_classless_wildcard_filtered_sources}")

  target_sources(modules PRIVATE ${mod_classless_wildcard_SOURCES})
  target_include_directories(modules PRIVATE
    ${CMAKE_SOURCE_DIR}/src
    ${CMAKE_SOURCE_DIR}/src/coa
    ${CMAKE_CURRENT_LIST_DIR}/src/coa
    ${CMAKE_CURRENT_LIST_DIR}/../../coa-core-input/src/server/coa
  )
endif()
